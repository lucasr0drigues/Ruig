RUIG_DOMAIN=ruig.example.com
ACME_EMAIL=admin@example.com

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
AllowedHosts=ruig.example.com

POSTGRES_DB=ruig
POSTGRES_USER=ruig
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

ConnectionStrings__Default=Host=postgres;Port=5432;Database=ruig;Username=ruig;Password=REPLACE_WITH_STRONG_DB_PASSWORD

Strava__ClientId=192043
Strava__ClientSecret=REPLACE_WITH_STRAVA_CLIENT_SECRET
Strava__RedirectUri=https://ruig.example.com/auth/strava/callback
Strava__AuthorizeBaseUrl=https://www.strava.com/oauth/authorize
Strava__TokenUrl=https://www.strava.com/oauth/token
Strava__ApiBaseUrl=https://www.strava.com/api/v3
Strava__WebhookVerifyToken=REPLACE_WITH_RANDOM_WEBHOOK_VERIFY_TOKEN
Strava__WebhookSubscriptionId=REPLACE_WITH_STRAVA_WEBHOOK_SUBSCRIPTION_ID

GitHub__GraphQLUrl=https://api.github.com/graphql
GitHub__AccessToken=REPLACE_WITH_GITHUB_ACCESS_TOKEN
GitHub__UserAgent=Ruig
GitHub__CacheTtl=01:00:00

TokenEncryption__CurrentKeyId=v1
TokenEncryption__Keys__v1=REPLACE_WITH_64_HEX_CHARACTER_AES_256_KEY
